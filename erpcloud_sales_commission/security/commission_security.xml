<odoo>
  <record id="module_category_commission" model="ir.module.category"><field name="name">Commissions</field><field name="sequence">45</field></record>
  <record id="privilege_commission" model="res.groups.privilege"><field name="name">Commissions</field><field name="category_id" ref="module_category_commission"/></record>
  <record id="group_commission_user" model="res.groups"><field name="name">Commission Salesperson</field><field name="privilege_id" ref="privilege_commission"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
  <record id="group_commission_manager" model="res.groups"><field name="name">Commission Manager</field><field name="privilege_id" ref="privilege_commission"/><field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/></record>
  <record id="group_commission_finance" model="res.groups"><field name="name">Commission Finance</field><field name="privilege_id" ref="privilege_commission"/><field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/></record>

</odoo>
