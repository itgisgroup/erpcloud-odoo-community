<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Bot partner (author of AI replies). Using partner only avoids user login concerns. -->
    <record id="partner_erpcloud_livechat_bot" model="res.partner">
        <field name="name">ERPCloud AI Assistant</field>
        <field name="is_company" eval="False"/>
    </record>

    <!-- Cron to process pending jobs (lightweight queue) -->
    <record id="ir_cron_erpcloud_livechat_ai_jobs" model="ir.cron">
        <field name="name">ERPCloud Livechat AI: Process Jobs</field>
        <field name="model_id" ref="model_erpcloud_livechat_job"/>
        <field name="state">code</field>
        <field name="code">model.run_pending_jobs(limit=10)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
