<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Blog Tag List View -->
    <record id="view_blog_tag_list" model="ir.ui.view">
        <field name="name">erpcloud.blog.tag.list</field>
        <field name="model">erpcloud.blog.tag</field>
        <field name="arch" type="xml">
            <list string="Thẻ" editable="bottom">
                <field name="name" string="Tên thẻ"/>
                <field name="slug" string="URL Slug" readonly="1"/>
                <field name="color" widget="color"/>
                <field name="post_count" string="Số bài viết" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Blog Tag Form View -->
    <record id="view_blog_tag_form" model="ir.ui.view">
        <field name="name">erpcloud.blog.tag.form</field>
        <field name="model">erpcloud.blog.tag</field>
        <field name="arch" type="xml">
            <form string="Thẻ">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên thẻ"/>
                        <h1>
                            <field name="name" placeholder="Nhập tên thẻ..." required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="slug" readonly="1"/>
                        </group>
                        <group>
                            <field name="color" widget="color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Blog Tag Kanban View -->
    <record id="view_blog_tag_kanban" model="ir.ui.view">
        <field name="name">erpcloud.blog.tag.kanban</field>
        <field name="model">erpcloud.blog.tag</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="color"/>
                <field name="post_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column" t-att-style="'border-left: 4px solid ' + record.color.raw_value">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="post_count"/> bài viết
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Blog Tag Action -->
    <record id="action_blog_tag" model="ir.actions.act_window">
        <field name="name">Thẻ</field>
        <field name="res_model">erpcloud.blog.tag</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo thẻ đầu tiên!
            </p>
            <p>
                Thẻ giúp gắn nhãn và tìm kiếm bài viết dễ dàng hơn.
            </p>
        </field>
    </record>

</odoo>
