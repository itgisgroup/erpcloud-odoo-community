<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_erpcloud_blog" model="ir.module.category">
        <field name="name">ERPCloud Blog</field>
        <field name="description">Manage blog posts, categories and comments</field>
        <field name="sequence">50</field>
    </record>
    <record id="res_groups_privilege_blog" model="res.groups.privilege">
        <field name="name">Blog &amp; News</field>
        <field name="category_id" ref="module_category_erpcloud_blog"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_blog_user" model="res.groups">
        <field name="name">Author</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_blog"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_blog_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_blog"/>
        <field name="implied_ids" eval="[(4, ref('group_blog_user'))]"/>
    </record>
    <record id="group_blog_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_blog"/>
        <field name="implied_ids" eval="[(4, ref('group_blog_editor'))]"/>
    </record>
</odoo>
