<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vn_address_migration" model="ir.module.category">
        <field name="name">Địa chỉ di cư</field>
    </record>

    <record id="group_vn_address_migration_user" model="res.groups">
        <field name="name">Người dùng di cư địa chỉ</field>
        <field name="category_id" ref="module_category_vn_address_migration"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_vn_address_migration_manager" model="res.groups">
        <field name="name">Quản lý di cư địa chỉ</field>
        <field name="category_id" ref="module_category_vn_address_migration"/>
        <field name="implied_ids" eval="[(4, ref('vn_address_migration.group_vn_address_migration_user'))]"/>
    </record>

    <!-- Respect multi-company: only see migrations in the user's allowed companies. -->
    <record id="rule_vn_address_migration_company" model="ir.rule">
        <field name="name">Address migration: multi-company</field>
        <field name="model_id" ref="model_vn_address_migration"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
