<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Video List View -->
    <record id="view_video_list" model="ir.ui.view">
        <field name="name">erpcloud.video.list</field>
        <field name="model">erpcloud.video</field>
        <field name="arch" type="xml">
            <list string="Videos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="video_url"/>
                <field name="duration"/>
                <field name="published_date"/>
                <field name="is_featured"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <!-- Video Kanban View -->
    <record id="view_video_kanban" model="ir.ui.view">
        <field name="name">erpcloud.video.kanban</field>
        <field name="model">erpcloud.video</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="video_id"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="'https://img.youtube.com/vi/' + record.video_id.raw_value + '/0.jpg'" alt="Thumbnail" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><field name="category_id"/></div>
                                <div><field name="duration"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Video Form View -->
    <record id="view_video_form" model="ir.ui.view">
        <field name="name">erpcloud.video.form</field>
        <field name="model">erpcloud.video</field>
        <field name="arch" type="xml">
            <form string="Video">
                <header>
                    <button name="action_publish" string="Xuất bản" type="object" class="oe_highlight" invisible="state == 'published'"/>
                    <button name="action_unpublish" string="Về nháp" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tiêu đề"/>
                        <h1><field name="name" placeholder="Nhập tiêu đề video..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="video_url" placeholder="https://www.youtube.com/watch?v=..."/>
                            <field name="video_id" readonly="1"/>
                            <field name="duration"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="published_date"/>
                            <field name="is_featured"/>
                            <field name="sequence"/>
                            <field name="view_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả" name="description">
                            <field name="description" placeholder="Mô tả ngắn hiển thị ở danh sách..."/>
                        </page>
                        <page string="Nội dung chi tiết" name="content">
                            <field name="content" widget="html" options="{'style-inline': true}"/>
                        </page>
                        <page string="SEO" name="seo">
                            <field name="website_meta_title"/>
                            <field name="website_meta_description"/>
                            <field name="website_meta_keywords"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_erpcloud_video_library" model="ir.actions.act_window">
        <field name="name">Videos</field>
        <field name="res_model">erpcloud.video</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo video đầu tiên!</p>
        </field>
    </record>
</odoo>
