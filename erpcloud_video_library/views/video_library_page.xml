      <t t-set="additional_title">Video Library</t>
      <div id="wrap" class="ec-video-page">
        <t t-call="erpcloud_video_library.s_video_library"/>
      </div>
    </t>
  </template>
  <record id="website_menu_video_library" model="website.menu">
    <field name="name">Videos</field>
    <field name="url">/video-library</field>
    <field name="parent_id" ref="website.main_menu"/>
    <field name="sequence">55</field>
  </record>
</odoo>
