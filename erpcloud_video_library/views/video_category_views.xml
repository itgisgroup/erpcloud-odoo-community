<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Video Category Views -->
    <record id="view_video_category_list" model="ir.ui.view">
        <field name="name">erpcloud.video.category.list</field>
        <field name="model">erpcloud.video.category</field>
        <field name="arch" type="xml">
            <list string="Danh mục video" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_video_category" model="ir.actions.act_window">
        <field name="name">Danh mục video</field>
        <field name="res_model">erpcloud.video.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Video Tag Views -->
    <record id="view_video_tag_list" model="ir.ui.view">
        <field name="name">erpcloud.video.tag.list</field>
        <field name="model">erpcloud.video.tag</field>
        <field name="arch" type="xml">
            <list string="Tags video" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_video_tag" model="ir.actions.act_window">
        <field name="name">Tags video</field>
        <field name="res_model">erpcloud.video.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
